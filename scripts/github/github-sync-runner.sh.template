#!/bin/bash
set -u

repo_root=__PROJECT_ROOT_SHELL__
sync_script=__SYNC_SCRIPT_SHELL__
log_path=__LOG_PATH_SHELL__
git_bin=__GIT_BIN_SHELL__
python_bin=__PYTHON_BIN_SHELL__
export PATH=__PATH_VALUE_SHELL__
export ORDINCONN_PUBLIC_PYTHON="$python_bin"

max_log_bytes=5242880
run_id="$(/usr/bin/uuidgen 2>/dev/null || /bin/date -u +%Y%m%dT%H%M%SZ)"

rotate_log() {
  local size=0
  if [ -f "$log_path" ]; then
    size="$(/usr/bin/stat -f %z "$log_path" 2>/dev/null || echo 0)"
  fi
  case "$size" in
    ''|*[!0-9]*) size=0 ;;
  esac
  if [ "$size" -ge "$max_log_bytes" ]; then
    /bin/rm -f -- "$log_path.1"
    /bin/mv -- "$log_path" "$log_path.1"
  fi
}

write_record() {
  local event=$1
  local branch=$2
  local scan=$3
  local changes=$4
  local commit=$5
  local push=$6
  local error=$7
  local status=$8
  /usr/bin/printf 'timestamp=%s run_id=%s event=%s repository="%s" branch="%s" scan=%s changes=%s commit=%s push=%s error=%s status=%s\n' \
    "$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ)" "$run_id" "$event" "$repo_root" "$branch" \
    "$scan" "$changes" "$commit" "$push" "$error" "$status" >> "$log_path"
}

/bin/mkdir -p -- "$(/usr/bin/dirname "$log_path")"
rotate_log

branch="$($git_bin -C "$repo_root" branch --show-current 2>/dev/null || true)"
if [ -z "$branch" ]; then
  write_record finish unknown unknown unknown not_created not_attempted TCC_OR_REPOSITORY_ACCESS_DENIED FAILED
  exit 2
fi

changes=none
if [ -n "$($git_bin -C "$repo_root" status --porcelain -- docs social/x/drafts .github/ISSUE_TEMPLATE .github/PULL_REQUEST_TEMPLATE.md 2>/dev/null || true)" ]; then
  changes=detected
fi
before_head="$($git_bin -C "$repo_root" rev-parse HEAD 2>/dev/null || true)"
write_record start "$branch" pending "$changes" pending pending none RUNNING

run_output="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/ordinconn-github-sync.XXXXXX")" || {
  write_record finish "$branch" unknown "$changes" not_created not_attempted TEMPFILE_FAILED FAILED
  exit 2
}
trap '/bin/rm -f -- "$run_output"' EXIT

set +e
ORDINCONN_PUBLIC_SYNC_REPO="$repo_root" \
ORDINCONN_PUBLIC_SYNC_LOG=/dev/null \
ORDINCONN_PUBLIC_PYTHON="$python_bin" \
"$sync_script" >"$run_output" 2>&1
result=$?
set -e

status="$(/usr/bin/grep -Eo '(PUBLIC_[A-Z0-9_]+|GITHUB_[A-Z0-9_]+|OUT_OF_SCOPE_[A-Z0-9_]+|UNPUSHED_[A-Z0-9_]+|OFFICIAL_[A-Z0-9_]+|GIT_REPOSITORY_REQUIRED)' "$run_output" | /usr/bin/tail -n 1 || true)"
[ -n "$status" ] || status=UNKNOWN_FAILURE

if [ "$result" -eq 0 ]; then
  after_head="$($git_bin -C "$repo_root" rev-parse HEAD 2>/dev/null || true)"
  commit=not_created
  push=not_needed
  if [ "$before_head" != "$after_head" ]; then
    commit=created
  fi
  if [ "$status" = "PUBLIC_DEVLOG_SYNCED" ]; then
    push=success
  fi
  write_record finish "$branch" pass "$changes" "$commit" "$push" none "$status"
  exit 0
fi

scan=unknown
case "$status" in
  *SECRET_SCAN_FAILED|*DIFF_CHECK_FAILED) scan=fail ;;
esac
write_record finish "$branch" "$scan" "$changes" not_created failed "$status" FAILED
exit "$result"
