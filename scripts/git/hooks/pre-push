#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
"$repo_root/scripts/security/check-git-identity.sh"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    if [[ "$local_sha" =~ ^0+$ ]]; then
      echo "FAIL: Deleting main is not allowed by this hook." >&2
      exit 1
    fi
    "$repo_root/scripts/security/check-public-history-identity.sh" "$local_sha"
  fi
done
